# Copy to backend/.env (and frontend/.env.local). NEVER commit or share the real files.

# ---- Backend ----
DATABASE_URL=postgresql://selfheal:selfheal@localhost:5432/selfheal
# Long random strings. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=
GITHUB_WEBHOOK_SECRET=

# LLM: groq | gemini | heuristic (heuristic works offline, no key needed)
LLM_PROVIDER=heuristic
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fine-grained token: Contents (read/write), Pull requests (write), Actions (read), Metadata (read)
GITHUB_TOKEN=

# Sandbox: docker (isolated, needs Docker) | local (dev only, NOT isolated)
SANDBOX_MODE=docker
SANDBOX_TIMEOUT_S=600
CORS_ORIGINS=http://localhost:3000

# ---- Frontend (server-side only) ----
BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=   # same value as API_KEY
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
